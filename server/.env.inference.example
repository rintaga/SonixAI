# Use the same base model ID that was used in the training workflow.
SONIX_BASE_MODEL=Qwen/Qwen2.5-Coder-0.5B-Instruct
# Extract Sonix-LoRA-Adapter artifact so this directory contains adapter_config.json.
SONIX_ADAPTER_DIR=./sonix-lora
# Set a long random value and enter the same value in Sonix > Settings.
SONIX_API_KEY=replace-with-a-long-random-secret
SONIX_CPU_THREADS=4
SONIX_MAX_NEW_TOKENS=2048
